# ================================
# LARIZINHA STORE - ENV EXAMPLE
# ================================

# ---- AMBIENTE ----
NODE_ENV=development          # development | production | test
BOT_MODE=test                 # test | production (controla credenciais usadas)

# ---- SERVIDOR WEB (para ativação, saque bancário, webhooks) ----
PORT=3000
PUBLIC_BASE_URL=https://seu-dominio.com   # URL pública para links de ativação e webhook

# ---- BANCO DE DADOS (PostgreSQL) ----
DATABASE_URL=postgresql://user:password@localhost:5432/larizinha_store?schema=public

# ---- REDIS (para Bull/BullMQ, filas, rate limiting) ----
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ---- TELEGRAM ----
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...   # Token do bot principal
TELEGRAM_BOT_TOKEN_TEST=123456:ABC-DEF...  # Token de teste (opcional)

# IDs dos administradores (separados por vírgula)
ADMIN_TELEGRAM_IDS=123456789,987654321
OWNER_TELEGRAM_ID=123456789

# Canal de anúncios (opcional)
TELEGRAM_CHANNEL_ID=@meucanal
TELEGRAM_CHANNEL_LINK=https://t.me/meucanal

# ---- MERCADO PAGO ----
MERCADO_PAGO_ACCESS_TOKEN=TEST-0000-0000...  # Produção
MERCADO_PAGO_ACCESS_TOKEN_TEST=TEST-0000-... # Sandbox
MERCADO_PAGO_PUBLIC_KEY=APP_USR-0000...
MERCADO_PAGO_WEBHOOK_SECRET=seu-segredo

# ---- WHATSAPP BUSINESS API ----
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=seu-token-de-verificacao
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789

# ---- E-MAIL (SMTP) ----
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@exemplo.com
SMTP_PASS=sua-senha
EMAIL_FROM="Larizinha Store <no-reply@exemplo.com>"

# ---- SEGURANÇA / JWT ----
JWT_SECRET=chave-secreta-bem-longa-e-aleatoria
JWT_EXPIRES_IN=1h

# ---- PIX ----
PIX_DEFAULT_EXPIRES_MINUTES=10
PIX_MIN_VALUE=1
PIX_MAX_VALUE=1000

# ---- BÔNUS ----
BONUS_ACTIVE=true
BONUS_PERCENT=10
BONUS_MIN_VALUE=10
BONUS_MAX_VALUE=1000

# ---- AFILIADOS ----
AFFILIATE_COMMISSION_PERCENT=20
AFFILIATE_MIN_WITHDRAWAL=20
AFFILIATE_WITHDRAWAL_FEE_FIXED=2
AFFILIATE_WITHDRAWAL_FEE_PERCENT=0

# ---- ANTI-FLOOD / RATE LIMITING ----
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=5
RATE_LIMIT_BLOCK_MINUTES=10
RATE_LIMIT_ESCALATION_STEPS=10,30,120,1440,0  # 0 = permanente

# ---- WEBHOOKS ----
WEBHOOK_MERCADO_PAGO_PATH=/webhooks/mercadopago
WEBHOOK_WHATSAPP_PATH=/webhooks/whatsapp

# ---- LOGGING ----
LOG_LEVEL=info        # trace | debug | info | warn | error | fatal
LOG_PRETTY=true

# ---- IA (se usar provedor externo) ----
OPENAI_API_KEY=sk-...        # opcional
AI_PROVIDER=openai           # openai | anthropic | etc.
AI_MODEL=gpt-4o-mini

# ---- OUTROS ----
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL
